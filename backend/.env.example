# ============================================================
# 编程答疑 Agent 环境配置模板
# 复制为 .env 后填入真实值（.env 不要提交到代码仓库）
# ============================================================

# ---- 阿里云百炼（通义千问）----
# 文本模型：qwen3.8-max（按用户指定；接入时以百炼平台实际模型标识为准）
# 视觉识别由 qwen3.8-max 完成（原生支持图像输入），VISION_MODEL 已弃用，可留空
DASHSCOPE_API_KEY=sk-你的百炼APIKey
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
VISION_MODEL=

# ---- Tavily 搜索 ----
TAVILY_API_KEY=tvly-你的TavilyKey
TAVILY_MAX_RESULTS=5

# ---- 阿里云 OSS ----
OSS_ACCESS_KEY_ID=你的AccessKeyID
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET=你的Bucket名称
# 必须与 Bucket 实际所在区域一致（如 oss-cn-beijing.aliyuncs.com）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 签名 URL 有效期（秒）
OSS_URL_EXPIRES=300

# ---- JWT 鉴权 ----
# 生产环境请更换为随机长字符串
SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=43200

# ---- SQLite ----
DATABASE_PATH=./app.db
